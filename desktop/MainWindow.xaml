<Window x:Class="CodexPresence.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Codex Presence" Width="640" Height="820" MinWidth="560" MinHeight="640"
 Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}" FontFamily="{DynamicResource BodyFont}" FontSize="{DynamicResource BodySize}"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
 WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border BorderBrush="{DynamicResource Line}" BorderThickness="1">
  <Grid>
  <Grid x:Name="MainContent">
   <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="20,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/logo-24.png" Width="24" Height="24" Margin="0,0,8,0"/><TextBlock Text="Codex Presence" FontWeight="SemiBold" FontSize="14"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="&#xE921;" AutomationProperties.Name="Minimize window" Width="40" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" Padding="0" Background="Transparent" BorderThickness="0" Click="MinimizeClick"/><Button x:Name="MaximizeButton" Content="&#xE922;" AutomationProperties.Name="Maximize window" Width="40" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" Padding="0" Background="Transparent" BorderThickness="0" Click="MaximizeClick"/><Button Content="&#xE8BB;" AutomationProperties.Name="Close window" Width="40" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" ToolTip="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource Self}}" Padding="0" Background="Transparent" BorderThickness="0" Click="CloseClick"/></StackPanel>
   </Grid>
   <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="16,4,16,0"><UniformGrid Columns="5" x:Name="Navigation"/></Border>
   <Border Grid.Row="2" x:Name="PinnedPreviewHost" MaxWidth="720" Margin="24,16,24,0" Visibility="Collapsed"/>
   <ScrollViewer Grid.Row="3" x:Name="PageScroll" Style="{StaticResource {x:Type ScrollViewer}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24"><StackPanel x:Name="PageBody" MaxWidth="720"/></ScrollViewer>
   <Border Grid.Row="4" x:Name="SaveHost" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12"/>
   <Border Grid.Row="5" x:Name="StatusPanel" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" MinHeight="36" Padding="24,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="FooterDot" Width="6" Height="6" Fill="{DynamicResource Neutral}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="Footer" AutomationProperties.Name="Status" AutomationProperties.LiveSetting="Polite" Text="Ready to start." FontSize="12" MaxHeight="52" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Muted}"/><Button x:Name="FooterDetails" Grid.Column="2" Content="Details" Style="{StaticResource TabButton}" Padding="8,0" MinHeight="20" Visibility="Collapsed" Click="FooterDetailsClick"/></Grid></Border>
  </Grid>
  <Border x:Name="DecisionPanel" AutomationProperties.Name="Unsaved changes" AutomationProperties.HelpText="Review changes, exit without saving, or cancel. Escape cancels." Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="{DynamicResource CardRadius}" Margin="16" Padding="20" MaxWidth="400" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><StackPanel x:Name="DecisionBody" KeyboardNavigation.TabNavigation="Cycle"/></Border>
  </Grid>
 </Border>
</Window>
